{
  "name": "pi-persistent-memory",
  "version": "0.0.0",
  "private": true,
  "description": "Independent Pi persistent memory with scoped SQLite storage and nine agent tools",
  "type": "module",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "test": "node --test test/**/*.test.ts benchmark/*.test.ts",
    "test:benchmark": "node --test benchmark/*.test.ts",
    "typecheck": "tsc --noEmit",
    "benchmark": "node benchmark/cli.ts"
  },
  "dependencies": {
    "sqlite-vec": "0.1.9"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.2",
    "@earendil-works/pi-tui": "1.0.3",
    "@types/node": "24.10.1",
    "typebox": "1.3.27",
    "typescript": "5.9.3"
  }
}
